{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radian",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-24",
  "env": {
    "production": {
      "vars": {
        "WEBAUTHN_RP_ID": "radian.nidr0x.win",
        "WEBAUTHN_ORIGIN": "https://radian.nidr0x.win",
        "WEBAUTHN_RP_NAME": "Radian"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "radian-prod",
          "database_id": "0281b5dc-187a-4363-9e59-f6c52442da7d"
        }
      ]
    },
    "preview": {
      "vars": {
        "WEBAUTHN_RP_ID": "",
        "WEBAUTHN_ORIGIN": "",
        "WEBAUTHN_RP_NAME": "Radian Preview"
      }
    }
  }
}
